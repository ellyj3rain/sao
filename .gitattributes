# Repository text uses repository-owned LF. (CRLF checkouts broke tools/check.sh
# under every POSIX shell on this machine; the gate is the file that cannot drift.)
.gitattributes text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.lua       text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.java      text eol=lf
*.txt       text eol=lf
mod.info    text eol=lf
VERSION     text eol=lf
.github/**  text eol=lf
*.jar       binary
*.png       binary
# Audit captures retain their recorded bytes across platforms.
artifacts/audits/** -text -whitespace
# Sealed model vectors retain their exported bytes. The empty tokenizer case
# deliberately has two empty TSV fields and therefore ends in two tabs.
tools/fixtures/coordination-r67/*.tsv -text -whitespace
# This sealed legacy producer artifact includes its original CRLF bytes.
tools/capability_experience_checks/legacy_archive.lua -text -whitespace
# Catalogue seals refer to captured bytes, including their original line endings.
Batches/*.json -text -whitespace
Batches/Transitions/*.json -text -whitespace
Batches/Transitions/C-20261003-compression* -text -whitespace
Batches/history/c-20261003-source/** -text -whitespace
Batches/history/d1-pre-closure/** -text -whitespace

# Preserve exact current-index/version bytes captured before the product correction.
Batches/history/c-20261005-before-product/** -text -whitespace
# Repurposed source provenance and native data retain sealed bytes.
mod/42.20/media/SAOSources/** -text -whitespace
mod/42.20/media/AnimSets/player/sitonground-sitting/SAORecovery_*.xml -text
mod/42.20/media/texturepacks/LS_Artwork.pack filter=lfs diff=lfs merge=lfs -text
# Captured native data and integrated producers retain their measured formatting.
mod/42.20/media/**/*.bak* -text -whitespace
mod/42.20/media/anims_X/** -text -whitespace
mod/42.20/media/registries.lua -whitespace
mod/42.20/media/lua/shared/ProjectArcade_SoundPolicy.lua -whitespace
mod/42.20/media/lua/client/SAO_LeisureArt.lua -whitespace
mod/42.20/media/lua/client/SAO_LeisureExercise.lua -whitespace
mod/42.20/media/lua/client/SAO_LeisureGames.lua -whitespace
# This measured producer retains original CRLF lines beside adapted LF lines.
mod/42.20/media/lua/client/TimedActions/NMDisassembleDeviceAction.lua -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
